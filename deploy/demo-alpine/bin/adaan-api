#!/bin/sh
# Start Core API via uvicorn. Packaged into the Core tarball next to .venv/
set -eu

ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
VENV="${ROOT}/.venv"
ENV_FILE="${ADAAN_ENV_FILE:-/etc/adaan/core.env}"

if [ -f "${ENV_FILE}" ]; then
	set -a
	# shellcheck disable=SC1090
	. "${ENV_FILE}"
	set +a
fi

# shellcheck disable=SC1091
. "${VENV}/bin/activate"

# Prefer package layout: installed wheel exposes api.main:app
export PYTHONPATH="${ROOT}/src${PYTHONPATH:+:$PYTHONPATH}"

exec uvicorn api.main:app \
	--host "${ADAAN_API_HOST:-127.0.0.1}" \
	--port "${ADAAN_API_PORT:-8000}" \
	--app-dir "${ROOT}/src"
