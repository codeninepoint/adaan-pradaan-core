# Copy to /etc/adaan/core.env and adjust secrets / CORS for your Pi.
# systemd EnvironmentFile= and OpenRC both source this before uvicorn.

TENANT_APP_ENV=dev
TENANT_KEYCLOAK_MODE=fake
TENANT_WORKFLOW_MODE=inline

TENANT_DATABASE_URL=postgresql+asyncpg://tenant:tenant@127.0.0.1:5432/tenant_platform

# Use a long random string for shared demos (even though APP_ENV=dev).
TENANT_JWT_SECRET=change-me-demo-secret-at-least-32-chars

# Same-origin via nginx on :80 — list the origins browsers will use.
# Replace with your Pi hostname and/or LAN IP as needed.
TENANT_CORS_ORIGINS=http://127.0.0.1,http://localhost

TENANT_PLATFORM_OPERATOR_EMAILS=

# Payments: stub (offline) | cashfree (sandbox/production PG)
TENANT_PAYMENTS_PROVIDER=stub
TENANT_CASHFREE_ENV=sandbox
TENANT_CASHFREE_APP_ID=
TENANT_CASHFREE_SECRET_KEY=
TENANT_CASHFREE_API_VERSION=2025-01-01
TENANT_CASHFREE_WEBHOOK_SECRET=
TENANT_CASHFREE_RETURN_URL_BASE=http://localhost:3000

# Entrypoint / OpenRC: run alembic before start
RUN_MIGRATIONS=true
